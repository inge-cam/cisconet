---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { PARROQUIA } from '../config/sitio';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion: string;
  /** `transparent` solo en páginas que abren con hero */
  header?: 'transparent' | 'solid';
  /** Imagen para compartir en redes y WhatsApp */
  imagen?: string;
}

const {
  titulo,
  descripcion,
  header = 'solid',
  imagen = '/og-default.jpg',
} = Astro.props;

const tituloCompleto =
  titulo === 'Inicio' ? PARROQUIA.nombre : `${titulo} — ${PARROQUIA.nombre}`;

const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbsoluta = new URL(imagen, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonica} />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={PARROQUIA.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>

  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>

    <Header variante={header} />

    <!-- Las páginas sin hero necesitan compensar el encabezado fijo -->
    <main id="contenido" class={header === 'solid' ? 'pt-16 md:pt-18' : ''}>
      <slot />
    </main>

    <Footer />
  </body>
</html>
