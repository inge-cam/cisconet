---
/**
 * Banda destacada — §6.10.
 *
 * Tres usos: bloque devocional de San Chárbel, banda de donación y CTA de
 * cierre. Toda página termina con una antes del pie (regla transversal §7).
 *
 * La marca de agua vegetal es el uso 4 del verde (§1.3): cedro y olivo al 6%,
 * guiño al Líbano de San Chárbel. A esa opacidad se lee como textura.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class:list={[
    'relative overflow-hidden rounded-lg bg-canvas-alt px-7 py-7 md:px-10 md:py-10',
    className,
  ]}
>
  <!-- Marca de agua: rama de olivo -->
  <svg
    class="pointer-events-none absolute -right-8 -bottom-8 size-64 text-green-700 opacity-6"
    viewBox="0 0 200 200"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M100 190C100 190 95 120 60 80C25 40 20 15 20 15"
      stroke="currentColor"
      stroke-width="4"
      stroke-linecap="round"
    ></path>
    {
      [0, 1, 2, 3, 4, 5].map((i) => (
        <>
          <ellipse
            cx={38 + i * 12}
            cy={40 + i * 22}
            rx="16"
            ry="8"
            fill="currentColor"
            transform={`rotate(${-35 + i * 6} ${38 + i * 12} ${40 + i * 22})`}
          />
          <ellipse
            cx={66 + i * 10}
            cy={52 + i * 22}
            rx="16"
            ry="8"
            fill="currentColor"
            transform={`rotate(${35 - i * 6} ${66 + i * 10} ${52 + i * 22})`}
          />
        </>
      ))
    }
  </svg>

  <div class="relative flex flex-col items-center gap-7 text-center md:flex-row md:text-left">
    <slot />
  </div>
</div>
