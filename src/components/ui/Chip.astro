---
/**
 * Etiqueta de categoría — §6.8.
 *
 * ÚNICO componente verde del contenido (§1.3, uso 1). Lleva texto siempre:
 * el color por sí solo no puede portar la información (§10).
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span
  class:list={[
    'text-body-s inline-flex items-center rounded-sm bg-green-100 px-3 py-1 font-semibold text-green-700',
    className,
  ]}
>
  <slot />
</span>
