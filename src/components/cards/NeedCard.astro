---
import IconoCircular from '../ui/IconoCircular.astro';

/**
 * Tarjeta del bloque "¿Qué necesitas?" — §6.6.
 *
 * El título va en primera persona ("Bautizar a mi hijo"), no en lenguaje
 * institucional ("Sacramento del Bautismo"): traduce el trámite al idioma
 * de quien llega buscando (bloque 6 del documento 02).
 */
interface Props {
  titulo: string;
  descripcion?: string;
  href: string;
  class?: string;
}

const { titulo, descripcion, href, class: className = '' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group flex flex-col items-center rounded-md border border-line bg-surface p-6 text-center shadow-sm transition-shadow hover:shadow-md',
    className,
  ]}
>
  <IconoCircular tamano={56} class="transition-colors group-hover:bg-gold-300/40">
    <slot name="icono" />
  </IconoCircular>

  <h3 class="text-h4 mt-4 font-body">{titulo}</h3>

  {descripcion && <p class="text-body-s mt-2 text-text-500">{descripcion}</p>}
</a>
